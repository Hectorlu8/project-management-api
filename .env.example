# Copy this file to .env and fill in real values for your local setup.
# .env is gitignored and must never be committed.

# SQLAlchemy connection string for the local PostgreSQL database.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/project_management

# Secret key used to sign JWT access tokens. Generate your own with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
