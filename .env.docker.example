# Copy this file to .env.docker and fill in real values.
# .env.docker is gitignored and must never be committed.
#
# Used only by docker-compose.yml. Note DATABASE_URL points at the
# service name "db", not localhost — inside the Docker network,
# containers reach each other by service name.

DATABASE_URL=postgresql+psycopg://postgres:password@db:5432/project_management
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Used to initialize the Postgres container on first run. Must match
# the user/password/dbname embedded in DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=project_management
