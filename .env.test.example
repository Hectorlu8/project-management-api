# Copy this file to .env.test and fill in real values for your local setup.
# .env.test is gitignored and must never be committed.
#
# Read only by the test suite (tests/conftest.py) — kept separate from
# .env/app/config.py on purpose, since Settings is strict about unknown
# variables and this one has nothing to do with the running app.

# Database used only by pytest. Its tables are dropped and recreated
# on every test run, so never point this at real data.
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/project_management_test
